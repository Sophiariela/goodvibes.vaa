# Good Vibes Va'a — variáveis de ambiente
#
# Copie para `.env.local` para desenvolvimento local (o Vercel CLI lê esse
# arquivo com `vercel dev`). Em produção, configure os mesmos valores no
# painel da Vercel (Project Settings → Environment Variables) ou via
# `vercel env add <nome>` — nunca comite `.env.local` nem valores reais.
#
# Veja docs/SETUP.md para o passo a passo de onde conseguir cada valor.

# ---------------------------------------------------------------------------
# Supabase (Project Settings → API / Database)
# ---------------------------------------------------------------------------
# URL do projeto, ex.: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# service_role key — SECRETA. Nunca expor no frontend. Usada só dentro das
# funções serverless (api/*) para acessar o PostgREST com privilégio total,
# ignorando RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Connection string direta do Postgres (Project Settings → Database →
# Connection string → "URI"), usada para rodar db/schema.sql e para
# transações com SELECT ... FOR UPDATE que o PostgREST não expõe.
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# Mercado Pago (developers.mercadopago.com → Suas integrações → Credenciais)
# ---------------------------------------------------------------------------
# Comece sempre com as credenciais de TESTE (sandbox). Só troque para
# produção depois de validar o fluxo completo com pagamentos de teste.
MP_ACCESS_TOKEN=

# Chave secreta de assinatura do webhook (configurada ao criar o webhook no
# painel do Mercado Pago). Usada para validar que a notificação realmente
# veio do Mercado Pago (cabeçalho x-signature).
MP_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Administração
# ---------------------------------------------------------------------------
# E-mails autorizados a logar na área /admin, separados por vírgula.
ADMIN_ALLOWED_EMAILS=

# ---------------------------------------------------------------------------
# Geral
# ---------------------------------------------------------------------------
# URL pública do site em produção (usada para montar o webhook e links de
# retorno do Mercado Pago). Em produção: https://goodvibesvaa.vercel.app
# (ou o domínio definitivo, se houver).
PUBLIC_BASE_URL=http://localhost:3000
